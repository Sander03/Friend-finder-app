# Kopieer dit bestand naar .env en vul de waarden in uit Supabase:
# Project Settings > API (Project URL en de publishable/anon key).
# Deze sleutel mag publiek zijn: Row Level Security beschermt de data.
# Zet hier NOOIT de secret/service_role key of het databasewachtwoord.
EXPO_PUBLIC_SUPABASE_URL=https://jouwproject.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
