{
  "expo": {
    "name": "Waarbenje",
    "slug": "waarbenje",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "waarbenje",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0F13"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Waarbenje",
      "shortName": "Waarbenje",
      "themeColor": "#0E0F13",
      "backgroundColor": "#0E0F13"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0E0F13",
    "icon": "./assets/icon.png"
  }
}
